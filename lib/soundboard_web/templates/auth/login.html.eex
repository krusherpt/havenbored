<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
        <%= if @action == "register" do %>
          Register
        <%= else %>
          Soundboard Login
        <% end %>
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        Haven Edition
      </p>
    </div>

    <% if @action == "login" do %>
      <form class="mt-8 space-y-6" method="post" action="/auth/login">
        <input type="hidden" name="action" value="login">

        <div>
          <label for="server_url" class="block text-sm font-medium text-gray-700">
            Haven Server URL
          </label>
          <input id="server_url" name="server_url" type="url" required
                 value="<%= @server_url %>"
                 class="mt-1 appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                 placeholder="https://haven.example.com">
        </div>

        <div class="rounded-md shadow-sm -space-y-px">
          <div>
            <label for="username" class="sr-only">Username</label>
            <input id="username" name="username" type="text" required
                   class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
                   placeholder="Username"
                   autocomplete="username">
          </div>
          <div>
            <label for="password" class="sr-only">Password</label>
            <input id="password" name="password" type="password" required
                   class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
                   placeholder="Password"
                   autocomplete="current-password">
          </div>
        </div>

        <div>
          <button type="submit"
                  class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Sign in
          </button>
        </div>
      </form>

      <div class="text-center">
        <a href="/auth/login?action=register" class="font-medium text-indigo-600 hover:text-indigo-500">
          Don't have an account? Register
        </a>
      </div>
    <% else %>
      <form class="mt-8 space-y-6" method="post" action="/auth/login">
        <input type="hidden" name="action" value="register">

        <div>
          <label for="reg_server_url" class="block text-sm font-medium text-gray-700">
            Haven Server URL
          </label>
          <input id="reg_server_url" name="server_url" type="url" required
                 value="<%= @server_url %>"
                 class="mt-1 appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                 placeholder="https://haven.example.com">
        </div>

        <div class="rounded-md shadow-sm -space-y-px">
          <div>
            <label for="reg_username" class="sr-only">Username</label>
            <input id="reg_username" name="username" type="text" required
                   class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
                   placeholder="Username (3-20 chars, alphanumeric + _)"
                   autocomplete="username"
                   pattern="[a-zA-Z0-9_]{3,20}">
          </div>
          <div>
            <label for="reg_password" class="sr-only">Password</label>
            <input id="reg_password" name="password" type="password" required
                   class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                   placeholder="Password (8-128 chars)"
                   autocomplete="new-password"
                   minlength="8"
                   maxlength="128">
          </div>
          <div>
            <label for="reg_token" class="sr-only">Registration Token (optional)</label>
            <input id="reg_token" name="registration_token" type="text"
                   class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                   placeholder="Registration token (if required)">
          </div>
        </div>

        <div>
          <button type="submit"
                  class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Register
          </button>
        </div>
      </form>

      <div class="text-center">
        <a href="/auth/login" class="font-medium text-indigo-600 hover:text-indigo-500">
          Already have an account? Sign in
        </a>
      </div>
    <% end %>

    <% if @flash[:error] || @error do %>
      <div class="rounded-md bg-red-50 p-4">
        <div class="flex">
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              <%= @flash[:error] || @error %>
            </h3>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
